<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>HidBridge.Host</AssemblyName>
    <RootNamespace>HidBridge.Host</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\HidBridge.Protocol\HidBridge.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="bridge.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="bridge.local.json" Condition="Exists('bridge.local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\'))</RepositoryRoot>
    <RootExecutablePublishDir>$(BaseIntermediateOutputPath)root-executable\$(Configuration)\</RootExecutablePublishDir>
  </PropertyGroup>

  <Target Name="PublishRootExecutable"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(BuildingRootExecutable)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=false;PublishSingleFile=true;PublishDir=$(RootExecutablePublishDir);BuildingRootExecutable=true" />
    <Copy SourceFiles="$(RootExecutablePublishDir)$(AssemblyName).exe"
          DestinationFiles="$(RepositoryRoot)$(AssemblyName).exe"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="根目录 EXE：$(RepositoryRoot)$(AssemblyName).exe" />
  </Target>
</Project>
