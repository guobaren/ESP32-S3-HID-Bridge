CONFIG_IDF_TARGET="esp32s3"
CONFIG_FREERTOS_HZ=1000
CONFIG_DUAL_PROXY_USE_CHERRYUSB=y
CONFIG_CHERRYUSB=y
CONFIG_CHERRYUSB_HOST=y
CONFIG_CHERRYUSB_HOST_DWC2_ESP=y
CONFIG_CHERRYUSB_HOST_HID=y
CONFIG_USBHOST_CONTROL_TRANSFER_TIMEOUT=500
# CONFIG_CHERRYUSB_DEVICE is not set
# CONFIG_CHERRYUSB_HOST_MSC is not set
# CONFIG_CHERRYUSB_HOST_CDC_ACM is not set
# CONFIG_CHERRYUSB_HOST_FTDI is not set
# CONFIG_CHERRYUSB_HOST_CH34X is not set
# CONFIG_CHERRYUSB_HOST_CP210X is not set
# CONFIG_CHERRYUSB_HOST_PL2303 is not set
