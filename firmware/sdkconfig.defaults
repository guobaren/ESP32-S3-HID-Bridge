CONFIG_IDF_TARGET="esp32s3"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESP_CONSOLE_UART_TX_GPIO=43
CONFIG_ESP_CONSOLE_UART_RX_GPIO=44
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_HID_COUNT=4
CONFIG_USB_HOST_HUBS_SUPPORTED=y
# 双板主镜像默认使用 CherryUSB 物理鼠标 Host；电脑侧 Device 路径仍使用 TinyUSB。
CONFIG_DUAL_PROXY_USE_CHERRYUSB=y
CONFIG_CHERRYUSB=y
CONFIG_CHERRYUSB_HOST=y
CONFIG_CHERRYUSB_HOST_DWC2_ESP=y
CONFIG_CHERRYUSB_HOST_HID=y
CONFIG_USBHOST_CONTROL_TRANSFER_TIMEOUT=500
# CONFIG_CHERRYUSB_DEVICE is not set
# CONFIG_CHERRYUSB_HOST_MSC is not set
# CONFIG_CHERRYUSB_HOST_CDC_ACM is not set
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
